{
  "name": "bill",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "npm test && npm run lint && npm run build",
    "lint": "eslint src tests/*.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:mobile": "node tests/mobile.cjs && node tests/ui-layout.cjs && node tests/annual-stats.cjs && node tests/spending-trend.cjs",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:release": "node scripts/android-build.mjs release",
    "format": "prettier --write src tests/*.ts tests/mobile.cjs scripts/*.mjs",
    "format:check": "prettier --check src tests/*.ts tests/mobile.cjs scripts/*.mjs"
  },
  "dependencies": {
    "lucide-react": "0.562.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
